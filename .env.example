# =============================================================================
# cloud-design - environment for `docker compose`
#
#   cp .env.example .env
#
# Every variable below is READ BY THE APPLICATION CODE. The names are not
# free-form: they are the exact names in
#   srcs/api-gateway-app/app/{proxy,queue_sender}.py, server.py
#   srcs/inventory-app/app/__init__.py, server.py
#   srcs/billing-app/app/{__init__,consume_queue}.py, server.py
#   srcs/{inventory,billing}-database/init-db.sh
#   srcs/rabbit-queue/entrypoint.sh
# and they match manifests/configmap.yaml + manifests/secrets.yaml 1:1, so the
# same variable drives the local stack and the Kubernetes manifests.
#
# -----------------------------------------------------------------------------
# The *_PASSWORD / *_USER values below are DEVELOPMENT PLACEHOLDERS ONLY.
# They are deliberately weak and public so nobody can mistake them for
# credentials: `postgres` and `inventory_app` are the built-in roles, and the
# AMQP account is created by srcs/rabbit-queue/entrypoint.sh, not baked into an
# image. For anything that is not a laptop, source the real values from AWS
# Secrets Manager (see terraform/rds.tf and terraform/amazon_mq.tf) or from a
# SealedSecret. NEVER commit a real .env - it is git-ignored.
#
# NOTE: if you change a *_PASSWORD here, the database and broker containers
# RECONCILE the role on the next start (init-db.sh `reconcile()`, entrypoint.sh
# `change_password`), so the change takes effect without dropping the volume.
# =============================================================================

# -----------------------------------------------------------------------------
# inventory-database  <->  inventory-app
# -----------------------------------------------------------------------------
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=dev_inventory_pw
INVENTORY_DB_NAME=inventory_db

# -----------------------------------------------------------------------------
# billing-database  <->  billing-app
# -----------------------------------------------------------------------------
BILLING_DB_USER=billing_app
BILLING_DB_PASSWORD=dev_billing_pw
BILLING_DB_NAME=billing_db

# -----------------------------------------------------------------------------
# rabbit-queue  <->  api-gateway-app + billing-app
# -----------------------------------------------------------------------------
# MUST NOT be `guest`: that is the broker's built-in account and
# srcs/rabbit-queue/entrypoint.sh deletes it, so the broker would be left with
# no usable user. The entrypoint rejects it at boot with an explicit message.
RABBITMQ_USER=cloud_design
RABBITMQ_PASSWORD=dev_rabbit_pw
RABBITMQ_QUEUE=billing_queue

# -----------------------------------------------------------------------------
# Tuning - non-secret, safe defaults live in the code, these only override them.
# -----------------------------------------------------------------------------

# Bounded DB-connect budget for inventory-app and billing-app (attempts x
# seconds). Must exceed a COLD database start: a fresh PostgreSQL cluster has
# can need a minute or more before it accepts connections, so the default
# 180 x 2s = 360s avoids turning a slow database into a restart loop.
DB_CONNECT_MAX_RETRIES=180
DB_CONNECT_RETRY_DELAY=2

# Throttle applied by billing-app before it nacks a message back onto the queue
# after a failed database write. With prefetch_count=1 this turns a database
# outage into a slow retry loop instead of a hot spin.
REDELIVERY_BACKOFF_SECONDS=5

# Bounded publish budget in api-gateway-app. Worst case for one POST
# /api/billing is 2 attempts x 3s, so a dead broker fails fast with HTTP 500
# instead of leaving the client hanging.
RABBITMQ_SOCKET_TIMEOUT=3
RABBITMQ_PUBLISH_MAX_RETRIES=2
RABBITMQ_RETRY_DELAY=1

# -----------------------------------------------------------------------------
# AMQPS / TLS - read by BOTH srcs/api-gateway-app/app/queue_sender.py and
# srcs/billing-app/app/consume_queue.py, which apply ONE identical rule so the
# publisher and the consumer can never disagree about the connection mode:
#
#   TLS ON  : RABBITMQ_TLS is truthy ("1"/"true"/"yes"/"on"), OR
#             RABBITMQ_TLS is unset AND (RABBITMQ_PORT is 5671 OR
#             RABBITMQ_HOST starts with "amqps://")
#   TLS OFF : RABBITMQ_TLS is falsy ("0"/"false"/"no"/"off"), OR the target
#             above does not imply TLS
#
# You normally set NOTHING here. Local compose uses RABBITMQ_PORT=5672, so the
# rule resolves to plaintext. On AWS, terraform injects RABBITMQ_PORT=5671 and
# a bare (scheme-stripped) hostname, and 5671 alone turns TLS on - Amazon MQ
# for RabbitMQ has no plaintext listener at all.
# -----------------------------------------------------------------------------

# Force the mode regardless of port. Leave EMPTY/unset to let the rule decide.
# RABBITMQ_TLS=true

# CA bundle (PEM) used to verify the broker certificate, as a path VISIBLE
# INSIDE the container - mount it, do not rely on a host path. Needed for a
# broker signed by a private/self-signed CA. It REPLACES the system trust store,
# so include every CA the broker may present. Leave empty on AWS: an Amazon MQ
# certificate chains to the public Amazon Trust Services CA, which the system
# store already trusts.
# RABBITMQ_CA_FILE=/etc/ssl/certs/amqps-ca.pem

# INSECURE opt-out, off by default. Set to false to accept ANY broker
# certificate without checking the CA or the hostname. That removes the
# protection against a man-in-the-middle reading the AMQP credentials and
# queued orders. Local throwaway test brokers with a self-signed certificate
# only - never in AWS or in the manifests.
# RABBITMQ_TLS_VERIFY=false
