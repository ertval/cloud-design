# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Stage 1: Build dependencies in isolated builder stage
# ------------------------------------------------------------------------------
FROM python:3.11-alpine AS builder

WORKDIR /build

RUN apk add --no-cache \
    gcc \
    musl-dev \
    libpq-dev \
    python3-dev

COPY srcs/inventory-app/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Minimal hardened runtime image
# ------------------------------------------------------------------------------
FROM python:3.11-alpine AS runner

RUN apk add --no-cache libpq && \
    addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S -G appgroup -h /home/appuser -s /sbin/nologin appuser

WORKDIR /usr/src/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_PORT=8080

COPY --from=builder /install /usr/local
COPY --chown=appuser:appgroup srcs/inventory-app/server.py .
COPY --chown=appuser:appgroup srcs/inventory-app/app/ ./app/

# Build-time smoke test verification
RUN python3 -c "import flask, waitress, flask_sqlalchemy, sqlalchemy, psycopg2"

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')" || exit 1

CMD ["python3", "server.py"]
