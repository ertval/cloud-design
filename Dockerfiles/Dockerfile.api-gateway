# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Stage 1: Build dependencies in isolated builder stage
# ------------------------------------------------------------------------------
FROM python:3.11-alpine AS builder

WORKDIR /build

RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev

COPY srcs/api-gateway-app/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Minimal hardened runtime image
# ------------------------------------------------------------------------------
FROM python:3.11-alpine AS runner

# Create dedicated non-root application user and group
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S -G appgroup -h /home/appuser -s /sbin/nologin appuser

WORKDIR /usr/src/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_PORT=3000

# Copy only installed python packages from builder stage
COPY --from=builder /install /usr/local

# Copy application artifacts with secure ownership
COPY --chown=appuser:appgroup srcs/api-gateway-app/server.py srcs/api-gateway-app/openapi.yaml ./
COPY --chown=appuser:appgroup srcs/api-gateway-app/app/ ./app/

# Create logs directory with non-root write access
RUN mkdir -p /usr/src/logs && chown -R appuser:appgroup /usr/src/logs

# Build-time smoke test verification
RUN python3 -c "import flask, waitress, pika, requests, yaml"

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3000/health')" || exit 1

CMD ["python3", "server.py"]
